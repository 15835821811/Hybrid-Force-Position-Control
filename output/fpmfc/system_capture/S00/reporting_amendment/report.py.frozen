"""Requirement-scoped S00 evidence audit and non-circular local handoff."""
import csv
import json
import time
from pathlib import Path
from .common import PROJECT,OUT,REGISTRY,OLD,BASE,RUNS,read,save,sha,digest,git,source_identity
from .contracts import PhaseResult,plain
from .profiling import summarize

def historical_git_changes():
    changed=git('diff','--name-only',BASE,'--').splitlines()
    allowed=('v6_mujoco/system_capture/','configs/system_capture/','experiments/system_capture/','output/fpmfc/system_capture/S00/','paper/system_framework/')
    bad=[p for p in changed if p and p!='.gitattributes' and not p.startswith(allowed)]
    old=git('show',BASE+':.gitattributes')
    now=(PROJECT/'.gitattributes').read_text(encoding='utf-8').strip()
    if not now.startswith(old):bad.append('.gitattributes historical rules changed')
    return bad

def report():
    from .phase import verify,ledger,record_operation
    start=time.perf_counter();cpu=time.process_time();m=verify();book=ledger();test=read(OUT/'tests.json')
    required=m['replay_order'];replays={k:read(OUT/'replays'/(k+'.json')) for k in required if (OUT/'replays'/(k+'.json')).exists()}
    profiles=[read(OUT/'runtime_profiles'/(name+'.json')) for name in RUNS if (OUT/'runtime_profiles'/(name+'.json')).exists()]
    all_records=[r for p in profiles for r in p['records']];summary=summarize(all_records)
    runtime={'summary':summary,'per_run':{name:read(OUT/'runtime_profiles'/(name+'.json')) for name in RUNS if (OUT/'runtime_profiles'/(name+'.json')).exists()},
      'environment':m['environment'],'scope':'same 16 preregistered controller states; inclusive instrumented function timings; nested calls overlap; NOT a real-time qualification; rejected/invalid/exception returns retained'}
    save(OUT/'runtime_profile.json',runtime)
    bad=historical_git_changes();criteria=[]
    def criterion(id_,requirement,passed,evidence):criteria.append({'id':id_,'requirement':requirement,'passed':bool(passed),'evidence':evidence})
    criterion('S00-01','exact baseline ancestry and independent branch',git('merge-base',BASE,'HEAD')==BASE and git('branch','--show-current')=='codex/system-s00-contracts','git merge-base; git branch')
    criterion('S00-02','historical source/model/config/results/media unchanged',not bad and all(sha(PROJECT/p)==h for p,h in m['input_identity'].items()),{'unexpected_git_changes':bad,'verified_input_files':len(m['input_identity'])})
    criterion('S00-03','contract unit/frame/time/deep-copy and reserved-stage tests',test['passed'] and test['tests_run']==len(m['synthetic_test_cases']) and test['source_content_hash']==m['source_content_hash'],'tests.json/tests.log; explicit frozen test case names')
    criterion('S00-04','two actuator and two decision replays within original tolerances',len(replays)==4 and all(r['passed'] and r['source_content_hash']==m['source_content_hash'] for r in replays.values()),'replays/*.json; ledger result identities')
    criterion('S00-05','actuator replays initialize once, never inject middle states',all(r.get('state_initializations')==1 and r.get('saved_intermediate_state_injections')==0 and r.get('actuator_channels')==7 for r in replays.values() if r['kind']=='actuator') and len([r for r in replays.values() if r['kind']=='actuator'])==2,'replay.py actuator loop; per-run result')
    criterion('S00-06','archived original return/packet/state/reference/guard/abort equals adapter',len([r for r in replays.values() if r['kind']=='decision'])==2 and all(r.get('direct_return_matches_adapter') and r.get('packet_roundtrip_match') and r.get('intermediate_match') and r.get('final_outcome_matches') for r in replays.values() if r['kind']=='decision'),'replay.py; exact archive runtime; baseline_equivalence.json')
    criterion('S00-07','no new physical experiments or automatic next phases',not book['new_physical_attempts'] and not book['next_phases_started'] and len(book['replays'])<=4,'run_ledger.json; S00 CLI rejects all other phases')
    criterion('S00-08','bounded identical-state four-module profiling includes failures',len(all_records)==16 and all(s['calls']>0 for s in summary.values()) and all(p['selected_packet_indices']==[r['packet_index'] for r in p['records']] for p in profiles),'runtime_profile.json; frozen packet indices')
    criterion('S00-09','model/algorithm registries and thin executable factories',set(read(REGISTRY/'models.json'))=={'flexiv_system','paper_compat_srs'} and set(read(REGISTRY/'algorithms.json'))=={'n208_baseline','n209_scalar_governor','paper_compat_reserved'},'registry.py; registry JSON; factory/unit/replay tests')
    for id_,file in [('S00-10','legacy_inventory.csv'),('S00-11','source_traceability.csv'),('S00-12','reproduction_map.csv')]:
        rows=list(csv.DictReader((OUT/file).open(encoding='utf-8')))
        paths=[r.get('file',r.get('code_file')) for r in rows]
        criterion(id_,file+' has real code/evidence references',bool(rows) and all((PROJECT/p).is_file() for p in paths),file)
    claims=list(csv.DictReader((PROJECT/'paper/system_framework/claim_evidence.csv').open(encoding='utf-8')))
    criterion('S00-13','three evidence classes and unsupported claims retained',{'SOURCE_REPRODUCTION','DECLARED_ADAPTATION','NEW_EXTENSION'}=={x['evidence_type'] for x in claims} and all(sha(PROJECT/x['evidence_file'])==x['sha256'] for x in claims) and {'NOT_SUPPORTED','NOT_DEMONSTRATED','NOT_EVALUATED'}<={x['status'] for x in claims},'paper/system_framework/claim_evidence.csv')
    ts=replays.get('R03_V2_S01__decision',{}).get('timestamp_snapshot_audit',[])
    criterion('S00-14','known S01 TS_AUDIT preserved without historical edits',len(ts)==1 and ts[0]['time']==0 and not read(OLD/'runs/R03_V2_S01/validation.json')['decision_replay_passed'],'new decision result; original failed validation.json; original tagged validation')
    record_operation('report_identity_audit',start,cpu)
    book=ledger();used=sum(x['cpu_s'] for x in book['operations'])+sum(x.get('cpu_s',0) for x in book['replays'])
    criterion('S00-15','CPU and state budgets',used<=m['budgets']['cpu_s'] and m['static_check_accounting']['total_upper_bound']<=100,{'recorded_process_cpu_s':used,'static_check_upper_bound':m['static_check_accounting']['total_upper_bound']})
    ok=all(x['passed'] for x in criteria)
    equivalence={'passed':all(r['passed'] for r in replays.values()) and len(replays)==4,'results':replays,
      'tolerances':m['tolerances'],'decision_interpretation':'one direct archived-controller invocation per packet inside the new composition adapter, compared with original saved returns and intermediate states; not two independent full passes',
      'new_controller_performance':False,'N209_task_failures_retained':['H2: NO_VERIFIED_CONTROL','S01: NO_VERIFIED_CONTROL']}
    save(OUT/'baseline_equivalence.json',equivalence)
    sensors={name:read(OLD/'runs'/name/'config.json')['sensors'] for name in RUNS}
    result=PhaseResult('PASS' if ok else 'FAIL','VERIFIED_IN_SCOPE' if criteria[3]['passed'] else 'NOT_EVALUATED','DECLARED_ADAPTATION','NOT_EVALUATED','NOT_SUPPORTED',
        {'protocol':'unchanged original N209 ideal and S01','configs':sensors,'validation_scope':'packet/decision compatibility only; no expanded sensor operating domain'},
        'PARTIAL','NOT_DEMONSTRATED','conditional' if ok else False)
    qualification={**plain(result),'phase':'S00','reproduction_by_domain':{'paper_compat_srs':'SOURCE_LIMITED/NOT_IMPLEMENTED','flexiv_system':'DECLARED_ADAPTATION'},
      'physical_model_scope':'two archived actuator/event reproductions with unchanged model; not new model/hardware qualification',
      'retained_N209_status':read(OLD/'qualification_matrix.json')['status'],'next_stage_reason':'S01 recommended only after explicit user authorization; source gaps remain; no S02-S08 execution',
      'hardware':'NOT_EVALUATED','realtime':'NOT_EVALUATED','full_interface_boundary':'historical failure retained'}
    save(OUT/'qualification.json',qualification)
    metrics={'phase':'S00','implementation_passed':ok,'new_physical_attempts':0,'replay_invocations':len(book['replays']),
      'actuator_replay_steps':sum(r.get('physics_steps',0) for r in replays.values()),'decision_predictive_steps':sum(r.get('predictive_steps',0) for r in replays.values()),
      'unit_test_cases':test['tests_run'],'read_only_input_files':len(m['input_identity']),'profiled_saved_states':len(all_records),
      'recorded_process_cpu_s':used,'cpu_budget_s':m['budgets']['cpu_s'],'resource_scope':'parent S00 operations plus child replay CPU including internal predictions; interactive editing and shell metadata inspection excluded',
      'static_or_single_state_upper_bound':m['static_check_accounting']['total_upper_bound'],'new_figures':0,'new_videos':0,'no_new_controller_performance':True}
    save(OUT/'metrics.json',metrics)
    save(OUT/'completion_audit.json',{'passed':ok,'requirements':criteria,'source_content_hash':m['source_content_hash']})
    text=f'''# S00 统一契约、基线适配与证据索引

状态：implementation = {qualification['implementation']}。本轮只执行 S00，从 `{BASE}` 建立 `codex/system-s00-contracts`，默认仅本地提交。

## 修改与边界

新增 `v6_mujoco/system_capture` 的数据契约、注册、组合适配、时钟调度、归档重放、剖析和证据报告。旧控制器/观测器/模型不移动、不改写；临时运行目录装载各轨迹原有源码的精确字节，不修改全局旧模块，不用当前版本冒充历史版本。原命令入口、碰撞/工具、执行器、载荷、任务门和所有旧结果/媒体保留。

`FrameConvention` 固定点线速度在前、角速度在后，wrench为力在前、力矩在后，SI、主动列向量旋转。旧基座广义速度单独拆为世界系线速度和体坐标角速度；需要世界系 twist 时显式旋转。SensorPacket 的机器人采样与送达/控制时刻保留，目标观测各自带采样/送达时刻；旧日志没有独立生成时刻，使用 null，不虚构时间。状态协方差、数组及嵌套快照使用独立不可变字节缓冲。

ScenarioSpec分开硬件、真值、先验、传感器、算法、任务、数值。控制器工厂只接受不含truth/场景标识的ControllerSetup和公开packet。静态源码接口与差分测试是软件边界证据，不是OS级隔离证明。四类门明确区分，8 mm预测跟踪门是算法接受条件，不能当物理碰撞裕量。

## 执行和结果

新物理尝试 **0**；两条既有轨迹的重放 **{len(book['replays'])}/4**；合成/接口测试 **{test['tests_run']}**；预选同批控制状态 **{len(all_records)}/16**；静态/单状态预算上界 **{m['static_check_accounting']['total_upper_bound']}/100**。记录的总过程CPU为 **{used:.3f} s / 14400 s**，包含重放内的预测，父进程与子进程分开汇总。代码编辑和只读shell查询不在过程CPU统计范围内。

两种重放分别验收。执行器重放仅t0初始化一次，重施记录力矩/锁紧事件，检查全时域qpos/qvel和接触掩码。决策重放中，适配器每包调用一次原归档控制器；逐包比较原返回与统一proposal，并对独立原记录核对tau、触发、状态机、估计、参考、guard、进度、参数和终止原因。不存在为比较而额外运行两条新完整决策轨迹。详细误差和源码身份见 baseline_equivalence.json。

S01保持NO_VERIFIED_CONTROL。其已知无效t0协方差日志别名仅按原TS_AUDIT使用同tick独立trace核对；原失败验证和原control_states文件保持不变。新快照隔离测试实际修改旧滤波器内部P，证明先前统一快照不随之改变。

distance gradient、HQP、state filter、predictor在预先登记的同一批状态原调用中剖析，失败/无效返回也计入。p50/p95/max、调用数量、环境在runtime_profile.json；嵌套inclusive耗时不能相加，含插桩开销，不能作为实时就绪证据。

## 证据与未支持结论

legacy_inventory.csv区分在用组件、仅被继承的工具函数和不在线的历史接触导纳。source_traceability.csv与reproduction_map.csv对齐梁斌论文的公式、图表、等价条件与迁移差异。型Ⅰ为基座姿态、型Ⅱ为臂形，均不是惯性估计。原文式(27)的末端零空间不自动推出基座无反作用；式(34)存在需澄清的导数/位移量纲约定。paper_compat_srs与paper_compat_reserved仅注册，返回NOT_IMPLEMENTED。

paper/system_framework建立三类证据矩阵和按来源/待验证问题组织的空论文骨架。当前鲁棒改进NOT_SUPPORTED、辨识控制收益NOT_DEMONSTRATED、硬件和实时NOT_EVALUATED。原N073仅支持固定完整方法规划轨迹上的执行级消融结论；N209仍为PARTIAL_OPERATING_DOMAIN_MISMATCH。S00不重新审计这些问题，也不将重放通过写成物理任务成功或方法收益。

## 验收与交接

逐要求核对见completion_audit.json。implementation、physical_model、reproduction、task、method_benefit、sensor_domain、parameter_identification、control_benefit与next_stage_admission分别写入qualification.json。下一阶段仅推荐S01，等待新授权。handoff.json保存输入提交和输出内容哈希；最终本地提交SHA存入Git公共目录旁路索引，避免Git提交包含自身SHA。未推送、未合并、未执行S01-S08。
'''
    (OUT/'report.md').write_text(text,encoding='utf-8',newline='\n')
    commands='''# S00 commands

Run in the S00 branch with the existing Python 3.10 / MuJoCo 3.3.2 environment.

```powershell
$env:OPENBLAS_NUM_THREADS='1'
$env:OMP_NUM_THREADS='1'
$env:PYTHONIOENCODING='utf-8'
python -m v6_mujoco.system_capture --phase S00 --mode prepare
python -m v6_mujoco.system_capture --phase S00 --mode test
python -m v6_mujoco.system_capture --phase S00 --mode replay
python -m v6_mujoco.system_capture --phase S00 --mode report
```

`run` invokes only the registered S00 replay plan and report, after prepare/tests. `--resume` requires exact source/config/environment/input identities and reuses only completed passing replays; incomplete or failed invocations are not restarted. Inspect the saved PID/process and logs before any intervention. No `--all` or implicit stage exists. Other phases return NOT_IMPLEMENTED with exit code 2 and create no outputs. Reserved paper-model factories likewise refuse execution.

The four-replay limit counts two t0 actuator/event streams and two packet decision streams. A direct archived-controller call is composed inside each adapter stream; its raw output and the independent original recording are both checked, without extra baseline passes. The temporary runtime view contains exact archived source bytes and only verified required assets plus the C1 pairing manifest. It is not a new maintained algorithm copy. All outputs go to S00; legacy runner entry points are never called.

After a successful local commit, record its SHA outside tracked content:

```powershell
python -c "from v6_mujoco.system_capture.report import record_local_commit; record_local_commit()"
```
'''
    (OUT/'commands.md').write_text(commands,encoding='utf-8',newline='\n')
    paths=list((PROJECT/'v6_mujoco/system_capture').rglob('*.py'))+list((PROJECT/'configs/system_capture').rglob('*.json'))
    paths+=list(REGISTRY.rglob('*.json'))+list((PROJECT/'paper/system_framework').glob('*'))
    paths += [p for p in OUT.rglob('*') if p.is_file() and p.name not in ('handoff.json','operation.lock') and 'manifest_history' not in p.parts]
    hashes={p.relative_to(PROJECT).as_posix():sha(p) for p in sorted(set(paths))}
    handoff={'phase':'S00','completed':ok,'input_commit':BASE,'branch':'codex/system-s00-contracts','source_content_hash':m['source_content_hash'],
        'output_content_hash':digest(hashes),'output_hashes':hashes,'output_commit':'recorded separately after local commit',
        'output_commit_sidecar':'<git-common-dir>/system_capture_releases/'+m['source_content_hash']+'.json',
        'reusable_components':['validated value contracts','model/algorithm registries','lossless legacy packet/controller adapters','integer clocks','archived-source replay runtime','evidence index'],
        'changed_configs':['new configs/system_capture/protocols/s00.json; no legacy configuration changed'],
        'remaining_failures':['N209 H2/S01 NO_VERIFIED_CONTROL','robust improvement NOT_SUPPORTED','identification control benefit NOT_DEMONSTRATED','hardware/full-boundary/realtime not verified','paper_compat_srs NOT_IMPLEMENTED; source ambiguities pending'],
        'next_stage':{'recommended':'S01','authorized':False,'admission':qualification['next_stage_admission'],'entry':'python -m v6_mujoco.system_capture --phase S01 --mode prepare','current_entry_behavior':'NOT_IMPLEMENTED until S01 is explicitly authorized and implemented'},
        'no_new_controller_performance':True,'pushed':False,'merged':False}
    save(OUT/'handoff.json',handoff);print(json.dumps({'S00_complete':ok,'qualification':qualification['implementation'],'content_hash':handoff['output_content_hash']}));return ok

def record_local_commit():
    h=read(OUT/'handoff.json')
    if not h['completed'] or git('status','--porcelain'):raise RuntimeError('completed clean local commit required')
    for p,d in h['output_hashes'].items():
        if sha(PROJECT/p)!=d:raise RuntimeError('handoff output changed '+p)
    root=Path(git('rev-parse','--git-common-dir'))
    if not root.is_absolute():root=PROJECT/root
    path=root/'system_capture_releases'/(h['source_content_hash']+'.json')
    save(path,{'phase':'S00','input_commit':BASE,'output_commit':git('rev-parse','HEAD'),'source_content_hash':h['source_content_hash'],
      'output_content_hash':h['output_content_hash'],'handoff_sha256':sha(OUT/'handoff.json'),'branch':git('branch','--show-current'),'pushed':False})
    print(json.dumps({'commit':git('rev-parse','HEAD'),'sidecar':str(path)},ensure_ascii=False))
